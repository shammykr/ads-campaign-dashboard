{
  "name": "ads-campaign-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && concurrently -n api,web \"npm:dev:api\" \"vite preview --port 4173\"",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "measure:sort": "node scripts/measure-sort-latency.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.1",
    "react-window": "^1.8.11",
    "recharts": "^2.15.4",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6"
  }
}
